NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_a_unique_password
NEO4J_DATABASE=neo4j
SERPER_API_KEY=replace_with_your_serper_api_key

# Total real enrichment Serper attempts allowed in this local workspace; durable across restarts.
# Set a conservative limit no greater than your remaining provider allowance.
ENRICHMENT_SEARCH_ALLOWANCE=0
# Used ONLY by dedicated built-in fictional fixture evaluation, never real jobs.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_gemini_api_key
